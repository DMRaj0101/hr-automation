# Identity Agent -- Keycloak (see app/integrations/keycloak_connector.py)
#How to get it
#Login to Keycloak Admin Console.
#Open your Realm.
#Clients.
#Click identity_agent.
#Credentials.
#Copy Client Secret.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vantara
KEYCLOAK_ADMIN_CLIENT_ID=identity_agent
KEYCLOAK_ADMIN_CLIENT_SECRET=#paste the generated secret
KEYCLOAK_SCOPED_HELPDESK_ROLE=helpdesk-admin-scoped


