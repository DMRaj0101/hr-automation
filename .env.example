# --- Backend ---
# DATABASE_URL=postgresql://poc:poc@localhost:5432/onboarding_poc
# For solo local dev without Postgres running, comment the line above and use:
DATABASE_URL=sqlite:///./poc_local.db

MOCK_HRMS_URL=http://localhost:9000

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TIMEOUT=8

JWT_SECRET=poc-dev-secret-change-me

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Notification email (Gmail) -- unchanged, still used for
# welcome emails / alerts / intimations (PDD Section 6) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASSWORD=<16-char app password, no spaces>
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=youraccount@gmail.com
IMAP_PASSWORD=<same app password>

IT_TEAM_EMAIL=your-it-team-inbox@example.com
HR_TEAM_EMAIL=your-hr-team-inbox@example.com
SECURITY_TEAM_EMAIL=your-security-team-inbox@example.com
MANAGER_TEAM_EMAIL=your-manager-team-inbox@example.com

# --- Monitoring Agent (PDD Section 5) ---
MONITORING_POLL_INTERVAL_SECONDS=30

# ==========================================================
# TODO -- new integration credentials. Each owner fills in their
# section as they implement the matching integrations/*_connector.py.
# Never commit real values -- this file is the template only.
# ==========================================================

