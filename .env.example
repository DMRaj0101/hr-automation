KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Email Agent -- MailU (see app/integrations/mailu_connector.py)
# TODO: confirm auth approach (admin API token vs CLI) before filling these in
MAILU_URL=
MAILU_ADMIN_TOKEN=

# Time & Billing Agent -- Kimai (see app/integrations/kimai_connector.py)
KIMAI_URL=
KIMAI_API_TOKEN=

# Asset Agent -- Snipe-IT (see app/integrations/snipeit_connector.py)
SNIPEIT_URL=
SNIPEIT_API_TOKEN=

# Document Management Agent -- OpenKM (see app/integrations/openkm_connector.py)
# NOTE: this upgrades 3 items from Mock to Functional beyond the original
# PDD Section 3 tables -- see openkm_connector.py's module docstring.
OPENKM_URL=
OPENKM_USER=
OPENKM_PASSWORD=
