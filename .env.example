MAILU_ADMIN_TOKEN=#paste the generated admin token
MAILU_DOMAIN=vantara.com
MAILU_TIMEOUT_SECONDS=10
MAILU_DEFAULT_QUOTA_BYTES=1073741824
MAILU_TEMP_PASSWORD_LENGTH=16

